cabal-version: 3.0
name: xmonad-macos
version: 0.3.0.0
synopsis: Native macOS portability fork of the xmonad policy core
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
category: System
extra-source-files:
    README.md
    CHANGELOG.md
    docs/*.md
    config/xmonad.hs
    native/*.swift
    native/Info.plist
    native/icon.svg
    native/menubar.svg
    native/MenuBarIcon.pdf
    native/AppIcon.icns
    scripts/*.sh
    tests/*.py
    tests/WireTests.swift
    .github/workflows/ci.yml

common defaults
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat
  build-depends:
      base >=4.16 && <5
    , containers >=0.6 && <0.9
    , mtl >=2.2 && <2.4
    , transformers >=0.5 && <0.7
    , aeson >=2.0 && <2.3
    , bytestring >=0.10 && <0.13
    , process >=1.6 && <1.7
    , directory >=1.3 && <1.4
    , filepath >=1.4 && <1.6

library
  import: defaults
  hs-source-dirs: src
  exposed-modules:
    XMonad
    XMonad.Core
    XMonad.StackSet
    XMonad.Layout
    XMonad.Operations
    XMonad.ManageHook
    XMonad.Config
    XMonad.Util.EZConfig
    XMonad.Util.Types
    XMonad.Util.SpawnOnce
    XMonad.Util.CustomKeys
    XMonad.Util.Run
    XMonad.Layout.LayoutModifier
    XMonad.Layout.LayoutCombinators
    XMonad.Layout.Spacing
    XMonad.Layout.ThreeColumns
    XMonad.Layout.Circle
    XMonad.Layout.Grid
    XMonad.Layout.Simplest
    XMonad.Layout.SimplestFloat
    XMonad.Layout.ResizableTile
    XMonad.Layout.Renamed
    XMonad.Layout.Named
    XMonad.Layout.Reflect
    XMonad.Layout.PerWorkspace
    XMonad.Layout.PerScreen
    XMonad.Layout.TwoPane
    XMonad.Layout.Accordion
    XMonad.Layout.Column
    XMonad.Layout.Spiral
    XMonad.Layout.Dwindle
    XMonad.Layout.OneBig
    XMonad.Layout.MultiColumns
    XMonad.Layout.StackTile
    XMonad.Layout.Dishes
    XMonad.Layout.CenteredIfSingle
    XMonad.Layout.Roledex
    XMonad.Layout.ToggleLayouts
    XMonad.Layout.IfMax
    XMonad.Layout.LimitWindows
    XMonad.Layout.Gaps
    XMonad.Actions.CycleWS
    XMonad.Actions.CycleWindows
    XMonad.Actions.WithAll
    XMonad.Actions.SinkAll
    XMonad.Actions.RotSlaves
    XMonad.Actions.SwapWorkspaces
    XMonad.Actions.DwmPromote
    XMonad.Actions.Promote
    XMonad.Actions.PhysicalScreens
    XMonad.Actions.CopyWindow
    XMonad.Actions.FocusNth
    XMonad.Actions.OnScreen
    XMonad.Actions.FindEmptyWorkspace
    XMonad.Actions.WindowGo
    XMonad.Actions.FloatKeys
    XMonad.Hooks.ManageHelpers
    XMonad.Hooks.InsertPosition
    XMonad.MacOS
    XMonad.MacOS.Types
    XMonad.MacOS.Protocol
    XMonad.MacOS.Engine
    XMonad.MacOS.CLI

executable xmonad-engine
  import: defaults
  hs-source-dirs: build/config, build/config/lib
  main-is: Main.hs
  ghc-options: -threaded -rtsopts
  build-depends: xmonad-macos

test-suite core-tests
  import: defaults
  type: exitcode-stdio-1.0
  hs-source-dirs: tests
  main-is: CoreTests.hs
  build-depends: xmonad-macos
